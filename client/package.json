{
  "name": "@keyweave/client",
  "version": "0.0.0",
  "private": true,
  "description": "Keyweave v0 browser client cryptographic core",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vendor.json",
    "gate": "npm run typecheck && npm test",
    "gen:wordlist": "node scripts/gen-wordlist.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "cbor2": "2.3.0",
    "qrcode": "1.5.4",
    "zxing-wasm": "2.2.4"
  },
  "devDependencies": {
    "@scure/bip39": "2.3.0",
    "happy-dom": "20.11.2",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
